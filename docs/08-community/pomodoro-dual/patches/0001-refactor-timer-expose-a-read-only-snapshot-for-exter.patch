From ae528dad7aec570d2d54dbbdaad0398528dfe566 Mon Sep 17 00:00:00 2001
From: upforever <upisqueen@gmail.com>
Date: Thu, 5 Nov 2026 11:52:29 +0800
Subject: [PATCH 1/3] refactor(timer): expose a read-only snapshot for external
 renderers

Timer carries eight states and a pile of fields that only its own layouts care about. Add snapshot() returning a small POD with just what an outside renderer needs: phase, run state, elapsed / remaining / overdue, cycle position and break lengths.

The snapshot deliberately does not reuse TimerState. It carries its own two enums (TimerPhase, TimerRunState), so the state machine stays private and can change without breaking callers.

Also adds SecondarySink and its call site in loop(), placed after display.display() rather than at the top of the loop. Notifying before the refresh makes a second panel read the timer one cycle early, which shows up as the two panels disagreeing by a second while paused.
---
 src/secondary_sink.h | 21 ++++++++++++++
 src/timer.cpp        | 69 ++++++++++++++++++++++++++++++++++++++++++++
 src/timer.h          | 11 +++++++
 src/timer_snapshot.h | 48 ++++++++++++++++++++++++++++++
 4 files changed, 149 insertions(+)
 create mode 100644 src/secondary_sink.h
 create mode 100644 src/timer_snapshot.h

diff --git a/src/secondary_sink.h b/src/secondary_sink.h
new file mode 100644
index 0000000..4ae9889
--- /dev/null
+++ b/src/secondary_sink.h
@@ -0,0 +1,21 @@
+#ifndef SECONDARY_SINK_H
+#define SECONDARY_SINK_H
+
+#include "timer_snapshot.h"
+
+// 副屏的唯一入口。
+//
+// Timer 不知道副屏是什么、接在哪、甚至有没有——它只在每次主屏刷新完之后
+// 调一次 onTimerSnapshot()。没有注册 sink 时这里连函数调用都不会发生，
+// 单屏固件的运行时行为因此零变化。
+//
+// fullRedraw 用来提示「主屏刚做过整屏刷」，副屏可以借这个时机一起整屏刷，
+// 避免两块屏的残影在不同时间点各自累积。
+class SecondarySink
+{
+public:
+    virtual ~SecondarySink() {}
+    virtual void onTimerSnapshot(const TimerSnapshot &snap, bool fullRedraw) = 0;
+};
+
+#endif // SECONDARY_SINK_H
diff --git a/src/timer.cpp b/src/timer.cpp
index 6fb4994..80c5bbc 100644
--- a/src/timer.cpp
+++ b/src/timer.cpp
@@ -416,15 +416,84 @@ void Timer::loop(volatile int *encoderCount)
             display.display(true);
         }
 
+        const bool wasFullRedraw = needsFullRedraw;
+
         menuNeedsRedraw = false;
         needsRedraw = false;
         needsFullRedraw = false;
         lastRedrawTime = millis();
         Serial.printf("Timer::loop: display update took %d ms\n", millis() - start);
+
+        // 主屏刚画完，此刻把同一份状态交给副屏。放在刷新之后而不是 loop 开头，
+        // 是为了让两块屏显示的永远是同一个瞬间的计时值——否则副屏会比主屏
+        // 早一个循环，暂停时会看到两块屏差一秒。
+        if (sink)
+        {
+            sink->onTimerSnapshot(snapshot(), wasFullRedraw);
+        }
     }
 }
 
 TimerState Timer::getState()
 {
     return state;
+}
+
+TimerSnapshot Timer::snapshot() const
+{
+    TimerSnapshot s;
+
+    s.presetName = currentPreset ? currentPreset->getName() : "";
+    s.focusDurationMs = currentPreset ? currentPreset->getDuration() : 0;
+    s.cycleTotal = currentPreset ? currentPreset->getLongPauseAfter() : 4;
+    s.completedCycles = cycles;
+    s.isLongBreak = isLongBreak;
+    s.breakDurationMs = currentBreakDuration
+                            ? currentBreakDuration
+                            : (currentPreset ? currentPreset->getPauseDuration() : 0);
+
+    const bool onBreak = (state == TimerState::RunningBreak ||
+                          state == TimerState::UserInitiatedBreakPause ||
+                          state == TimerState::WaitingConfirmEndOfBreak);
+
+    if (state == TimerState::SelectingPreset || state == TimerState::Stopped)
+    {
+        s.phase = TimerPhase::Idle;
+        s.runState = TimerRunState::Idle;
+    }
+    else
+    {
+        s.phase = onBreak ? TimerPhase::Break : TimerPhase::Focus;
+
+        switch (state)
+        {
+        case TimerState::Running:
+        case TimerState::RunningBreak:
+            s.runState = TimerRunState::Running;
+            break;
+        case TimerState::UserInitiatedPause:
+        case TimerState::UserInitiatedBreakPause:
+            s.runState = TimerRunState::Paused;
+            break;
+        case TimerState::WaitingConfirmStartOfBreak:
+        case TimerState::WaitingConfirmEndOfBreak:
+            s.runState = TimerRunState::Finished;
+            break;
+        default:
+            s.runState = TimerRunState::Idle;
+            break;
+        }
+    }
+
+    s.durationMs = onBreak ? s.breakDurationMs : s.focusDurationMs;
+    s.elapsedMs = elapsed;
+    s.remainingMs = s.durationMs > s.elapsedMs ? s.durationMs - s.elapsedMs : 0;
+    s.overdueMs = s.elapsedMs > s.durationMs ? s.elapsedMs - s.durationMs : 0;
+
+    const unsigned int setTotal = s.cycleTotal ? s.cycleTotal : 4;
+    s.cycleIndex = onBreak
+                       ? ((cycles % setTotal == 0) ? setTotal : cycles % setTotal)
+                       : (cycles % setTotal) + 1;
+
+    return s;
 }
\ No newline at end of file
