# pc-console（创作者门户 + 运营总览）上游地址配置
#
# 用法：复制本文件为 apps/pc-console/.env，按当前机器填写。
#   cp apps/pc-console/.env.example apps/pc-console/.env
# .env 不进 git（见仓库根 .gitignore），所以每台机器 / 服务器各自维护一份。
# 端口、主机全部在这里配，next.config.mjs 里不再写死。
#
# 加载优先级（Next 内置）：.env.local > .env.production / .env.development > .env

# 平台后端（FastAPI xiaowu_platform）：/backend/* 反代到这里
XIAOWU_API_BASE=http://127.0.0.1:8104

# 内容配置台（apps/content-console-cn）：/admin/* 反代到这里
# 优先填「根地址」，不要带 /admin 后缀（next.config 会自动剥掉尾巴上的 /admin）。
# 同机部署填本机地址；分机部署填那台机器的地址。
# 本地域名模式下填 http://dualcn.localhost —— 与线上两个独立子域的结构一致。
XIAOWU_CONTENT_CONSOLE_URL=http://127.0.0.1:8094

# 本地域名模式（dev-proxy）专用：允许哪些 host 在 dev 下访问 /_next 资源。
# 不配则用 next.config.mjs 里的默认值（已含 dual.localhost / dualcn.localhost）。
# ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,dual.localhost,dualcn.localhost

# ---------------------------------------------------------------------------
# 本地开发的三档配置（由 switch-env.bat 生成 .env.local 覆盖本文件）：
#   local   : 端口区分，XIAOWU_CONTENT_CONSOLE_URL=http://127.0.0.1:8094
#   domain  : 域名复刻（推荐），=http://dualcn.localhost，访问 http://dual.localhost/
#   online  : 连线上后端，XIAOWU_API_BASE=https://dual.xiaowuai.vip/backend
#
# 注意：服务器上的 .env 是「这台服务器连哪里」，本地是「我的开发机连哪里」，
# 两者不能共用一份。线上 XIAOWU_API_BASE 应指向后端内网地址（如 127.0.0.1:8104），
# 不要填公网域名，否则 /backend 会自己反代自己。
# ---------------------------------------------------------------------------
