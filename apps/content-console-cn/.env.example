# 内容配置台（apps/content-console-cn）配置模板
#
# 用法：复制为 apps/content-console-cn/.env 后按当前机器填写。
# 端口 / 主机只写在这里，next.config.ts 与页面代码里都不写死。
# 加载优先级（Next 内置）：.env.local > .env.[NODE_ENV] > .env

# 平台后端（FastAPI xiaowu_platform）：/api/* 反代到这里
INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8104

# 「开发者中心」链接（跳到创作者门户）。门户现在就在域名根路径，填 / 即可；
# 需要跳完整地址时再填完整 URL。
NEXT_PUBLIC_DEVELOPER_CENTER_URL=/
