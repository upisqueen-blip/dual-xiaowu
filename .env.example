XIAOWU_DEV_MODE=true
XIAOWU_DATABASE_PATH=./data/xiaowu.db
XIAOWU_ADMIN_KEY=
XIAOWU_DEFAULT_APP_KEY=change-me
XIAOWU_DEMO_USER_TOKEN=change-me
XIAOWU_ADMIN_USERNAME=
XIAOWU_ADMIN_PASSWORD=

# ============================================
# 在线刷机页 / 固件发布来源
# ============================================
# 由 webapp 的 /api/firmware/releases 转发到这里。主仓库（GITHUB_OWNER/GITHUB_REPO，
# 默认 datascale-ai/inksight）恒排第一，这里用逗号追加自有仓库。
# S3 双屏固件发布在 dual-xiaowu 的 Releases，资产名需匹配
# xiaowu_s3_dual_<42|583>_<3c|4c>.bin；缺了这行，烧录页只看到 C3 的旧固件。
GITHUB_FIRMWARE_REPOS=upisqueen-blip/dual-xiaowu
# 可选：多仓库聚合/私有仓库时抬高 GitHub API 配额（只读公开仓库也建议配）
# GITHUB_TOKEN=ghp_xxx
