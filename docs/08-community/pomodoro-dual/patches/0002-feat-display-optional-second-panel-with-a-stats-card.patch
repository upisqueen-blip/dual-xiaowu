   pinMode(2, OUTPUT);
@@ -103,6 +109,13 @@ void setup()
   display.init(115200, true, 2, false);
   display.setRotation(0);
 
+#ifdef EPD2_ENABLE
+  // 副屏：主屏上面刚做完整屏复位，共用 RST 的副屏不再重复复位（否则会把
