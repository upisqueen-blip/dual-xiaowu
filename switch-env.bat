@echo off
REM ============================================================
REM  Switch local dev environment.
REM    switch-env.bat local    front-end -> local backend 127.0.0.1:8104
REM    switch-env.bat domain   front-end -> local DOMAINS (dual.localhost /
REM                            dualcn.localhost via dev-proxy). This is the
REM                            mode that matches the production topology.
REM    switch-env.bat online   front-end -> production (dual.xiaowuai.vip)
REM
REM  Why "domain" exists: production separates services by DOMAIN, while a
REM  plain port setup shares cookies across localhost ports and never exercises
REM  reverse-proxy headers. Domain mode reproduces the production topology.
REM
REM  ASCII-only file: cmd.exe parses .bat with the OEM codepage.
REM ============================================================
setlocal
if "%~1"=="" goto usage

if /i "%~1"=="local" (
    > "apps\pc-console\.env.local" (
        echo # generated by switch-env.bat local
        echo XIAOWU_API_BASE=http://127.0.0.1:8104
        echo XIAOWU_CONTENT_CONSOLE_URL=http://127.0.0.1:8094
    )
    > "apps\content-console-cn\.env.local" (
        echo # generated by switch-env.bat local
        echo INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8104
        echo NEXT_PUBLIC_BASE_PATH=
        echo NEXT_PUBLIC_DEVELOPER_CENTER_URL=http://127.0.0.1:8101/
        echo ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
    )
    echo.
    echo [LOCAL] port mode. Front-end -^> http://127.0.0.1:8104
    echo   Portal      : http://localhost:8101/
    echo   Ops         : http://localhost:8101/center
    echo   Content     : http://localhost:8094/
    echo   Start order : run_backend.bat  then  start_all.bat
    goto done
)

if /i "%~1"=="domain" (
    > "apps\pc-console\.env.local" (
        echo # generated by switch-env.bat domain
        echo XIAOWU_API_BASE=http://127.0.0.1:8104
        echo XIAOWU_CONTENT_CONSOLE_URL=http://dualcn.localhost
    )
    > "apps\content-console-cn\.env.local" (
        echo # generated by switch-env.bat domain
        echo INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8104
        echo NEXT_PUBLIC_BASE_PATH=
        echo NEXT_PUBLIC_DEVELOPER_CENTER_URL=http://dual.localhost/
        echo ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,dual.localhost,dualcn.localhost
    )
    echo.
    echo [DOMAIN] production-like mode. Same topology as dual / dualcn.
    echo   Portal      : http://dual.localhost/
    echo   Ops         : http://dual.localhost/center
    echo   Content     : http://dualcn.localhost/
    echo   Route table : http://localhost/
    echo.
    echo   Start order : run_backend.bat
    echo                 then  start_all.bat
    echo                 then  dev-proxy\start.bat  ^(keep its window open^)
    goto done
)

if /i "%~1"=="online" (
    > "apps\pc-console\.env.local" (
        echo # generated by switch-env.bat online
        echo XIAOWU_API_BASE=https://dual.xiaowuai.vip/backend
        echo XIAOWU_CONTENT_CONSOLE_URL=https://dualcn.xiaowuai.vip
    )
    > "apps\content-console-cn\.env.local" (
        echo # generated by switch-env.bat online
        echo INKSIGHT_BACKEND_API_BASE=https://dual.xiaowuai.vip/backend
        echo NEXT_PUBLIC_BASE_PATH=
        echo NEXT_PUBLIC_DEVELOPER_CENTER_URL=https://dual.xiaowuai.vip/
        echo ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
    )
    echo.
    echo [ONLINE] front-end -^> https://dual.xiaowuai.vip/backend
    echo   No local backend needed. Restart BOTH Next dev servers.
    goto done
)

:usage
echo Usage:
echo   switch-env.bat local    local ports  (127.0.0.1:8104 backend)
echo   switch-env.bat domain   local DOMAINS (dual.localhost / dualcn.localhost)
echo   switch-env.bat online   production   (dual.xiaowuai.vip)
echo.
echo After switching, restart BOTH Next dev servers:
echo   apps\content-console-cn  (port 8094)
echo   apps\pc-console          (port 8101)
goto done

:done
echo.
echo Note: .env.local overrides .env. Delete it to fall back to .env.
