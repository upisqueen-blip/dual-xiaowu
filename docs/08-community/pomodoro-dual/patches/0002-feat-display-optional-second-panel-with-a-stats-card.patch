From 719327122b9efe7c5a9f94aaba81c47dcd06caef Mon Sep 17 00:00:00 2001
From: upforever <upisqueen@gmail.com>
Date: Thu, 5 Nov 2026 11:52:33 +0800
Subject: [PATCH 2/3] feat(display): optional second panel with a stats card

Adds SecondaryStats, a working SecondarySink implementation for a second e-paper panel: the big number is pomodoros completed in the current set, cycle position on the right, a progress bar towards the long break, and the next step in the footer. The font scale switches at width >= 640 so the same layout works on 400x300 and 800x480.

Nothing is hardcoded. Panel model, pins and colour depth all come from build_flags through dual_config.h. With EPD2_ENABLE undefined the translation unit is empty and single-panel builds are unchanged.

Two things worth knowing, both cost me an evening: RST must be -1 for the second panel when the reset line is shared, otherwise a second GxEPD2 instance resets the first panel right after it finished init (GxEPD2 already guards with 'if (_rst >= 0)'). And DC must be the real pin number rather than -1, because both panels share DC on one SPI bus and PIN_NONE makes the panel never latch a command.
---
 platformio.ini          |  23 ++++
 src/dual_config.h       |  68 ++++++++++++
 src/main.cpp            |  13 +++
 src/secondary_stats.cpp | 225 ++++++++++++++++++++++++++++++++++++++++
 src/secondary_stats.h   |  40 +++++++
 5 files changed, 369 insertions(+)
 create mode 100644 src/dual_config.h
 create mode 100644 src/secondary_stats.cpp
 create mode 100644 src/secondary_stats.h

diff --git a/platformio.ini b/platformio.ini
index a9b6f0f..a20d11a 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -17,3 +17,26 @@ lib_deps =
 	zinggjm/GxEPD2@^1.6.2
 	madhephaestus/ESP32Encoder@^0.11.7
 	makuna/NeoPixelBus@^2.8.3
+
+; ─── 可选：加一块副屏（B 屏） ───────────────────────────────────────────────
+;
+; 本 env 的引脚是占位值，跑之前换成你自己的。不用副屏就删掉这一整段，
+; 上面的默认 env 编译出来的固件与单屏版本完全一致。
+;
+; 要点：
+;   EPD2_CS   必须与主屏不同（片选独立）
+;   EPD2_BUSY 必须独立（忙信号是点对点的，不能共用）
+;   EPD2_DC   填与主屏相同的引脚号（两条 SPI 从机共享同一条 DC）
+;   EPD2_RST  共用复位线时填 -1，让主屏那次复位统一处理
+;   EPD2_3COLOR  三色面板才定义，黑白屏请删掉这一行
+;
+[env:dual]
+extends = env:az-delivery-devkit-v4
+build_flags =
+    -DEPD2_ENABLE=1
+    -DEPD2_DRIVER_CLASS=GxEPD2_420
+    -DEPD2_CS=5
+    -DEPD2_DC=8
+    -DEPD2_BUSY=4
+    -DEPD2_RST=-1
+
diff --git a/src/dual_config.h b/src/dual_config.h
new file mode 100644
index 0000000..efca9a5
--- /dev/null
+++ b/src/dual_config.h
@@ -0,0 +1,68 @@
+#ifndef DUAL_CONFIG_H
+#define DUAL_CONFIG_H
+
+// ---------------------------------------------------------------------------
+// 第二块屏（B 屏 / 副屏）的全部配置入口。
+//
+// 型号、引脚、色数一律通过 platformio.ini 的 build_flags 注入，源码里不写死
+// 任何板级参数——换一块屏只需要改 ini，不需要动代码。
+//
+//   build_flags =
+//       -DEPD2_ENABLE=1
+//       -DEPD2_DRIVER_CLASS=GxEPD2_420   ; 换成你自己面板对应的 GxEPD2 类
+//       -DEPD2_CS=39                     ; 第二块屏的 CS（必须与主屏不同）
+//       -DEPD2_DC=8                      ; 与主屏共用 DC 时填同一个引脚号
+//       -DEPD2_BUSY=40                   ; 第二块屏的 BUSY（必须独立）
+//       -DEPD2_RST=-1                    ; 与主屏共用 RST 时填 -1
+//       -DEPD2_3COLOR=1                  ; 三色面板才需要，黑白不要定义
+//
+// 未定义 EPD2_ENABLE 时，本文件不产生任何符号，整个副屏功能被预处理器剔除，
+// 编译产物与你原来的单屏版本逐字节等价。
+// ---------------------------------------------------------------------------
+
+#ifdef EPD2_ENABLE
+
+#include <GxEPD2.h>
+#include <GxEPD2_BW.h>
+#include <GxEPD2_3C.h>
+
+#ifndef EPD2_DRIVER_CLASS
+// 默认给一个 4.2 寸 400x300 黑白面板（GDEW042T2）当占位，
+// 不匹配你的屏时刷出来会是花屏或全白，改这个宏即可。
+#define EPD2_DRIVER_CLASS GxEPD2_420
+#endif
+
+#ifndef EPD2_CS
+#error "EPD2_CS 未定义：第二块屏的片选引脚必须显式给出。"
+#endif
+#ifndef EPD2_BUSY
+#error "EPD2_BUSY 未定义：第二块屏的 BUSY 引脚必须独立。"
+#endif
+#ifndef EPD2_DC
+#error "EPD2_DC 未定义：填入与主屏相同的 DC 引脚号。"
+#endif
+
+// 共用 RST 时传 -1，让 GxEPD2 跳过自己的复位流程（由主屏那次复位统一处理）。
+// 两块屏各自持有一个 RST 实例会互相打断对方的复位时序。
+#ifndef EPD2_RST
+#define EPD2_RST -1
+#endif
+
+// GxEPD2 库里没有 MAX_HEIGHT，那是示例代码自己定义的。这里直接给整屏缓冲：
+// 4.2 寸 400x300 约 15KB，800x480 约 48KB。RAM 吃紧可以调小，GxEPD2 会自动
+// 退化成按页渲染（paged），只是刷新会慢一些。
+#ifndef EPD2_BUFFER_HEIGHT
+#define EPD2_BUFFER_HEIGHT (EPD2_DRIVER_CLASS::HEIGHT)
+#endif
+
+#ifdef EPD2_3COLOR
+#define EPD2_CLASS GxEPD2_3C<EPD2_DRIVER_CLASS, EPD2_BUFFER_HEIGHT>
+#define EPD2_ACCENT GxEPD_RED
+#else
+#define EPD2_CLASS GxEPD2_BW<EPD2_DRIVER_CLASS, EPD2_BUFFER_HEIGHT>
+#define EPD2_ACCENT GxEPD_BLACK
+#endif
+
+#endif // EPD2_ENABLE
+
+#endif // DUAL_CONFIG_H
