# Xiaowu S3 Open Platform - systemd 守护单元示例
# 用法：
#   1) 把本文件放到 /etc/systemd/system/xiaowu-backend.service
#   2) 按需修改 User / WorkingDirectory / 虚拟环境 python 路径
#   3) 把生产配置写进 Environment（或 EnvironmentFile=/opt/xiaowu/.env，见下方注释）
#   4) sudo systemctl daemon-reload && sudo systemctl enable --now xiaowu-backend
#
# 注意：.env 被 gitignore，不会随代码上传。二选一提供配置：
#   A) 用下面的 Environment= 直接写死生产变量（推荐，密钥不落盘到仓库）
#   B) 在服务器手动创建 /opt/xiaowu/.env 并取消注释 EnvironmentFile 那一行
[Unit]
Description=XiaoWu S3 Open Platform Backend
After=network.target

[Service]
Type=simple
User=upisq
WorkingDirectory=/opt/xiaowu/xiaowu-s3-open-platform
ExecStart=/opt/xiaowu/xiaowu-s3-open-platform/.venv/bin/python -m uvicorn xiaowu_platform.main:app --host 0.0.0.0 --port 8104
# 方式 A：直接注入生产环境变量（把 valores 换成真实值，不要写进仓库）
Environment=XIAOWU_DEV_MODE=false
Environment=XIAOWU_ADMIN_USERNAME=change-me
Environment=XIAOWU_ADMIN_PASSWORD=change-me
Environment=XIAOWU_ADMIN_KEY=
Environment=XIAOWU_DEFAULT_APP_KEY=change-me
Environment=XIAOWU_DEMO_USER_TOKEN=change-me
Environment=XIAOWU_PUBLIC_BASE_URL=https://your-domain.example.com
# 方式 B：改用服务器上的 .env 文件（确保该文件权限 600，属主为本 User）
# EnvironmentFile=/opt/xiaowu/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
