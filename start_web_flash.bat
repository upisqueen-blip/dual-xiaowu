@echo off
REM ============================================================
REM  Xiaowu website + online flasher (LOCAL)
REM
REM    page      : http://localhost:8091/zh/flash   (also /en/flash)
REM    api       : http://127.0.0.1:8092           (services/legacy-api)
REM
REM  Two processes, because the page and its API live in two places:
REM    - page : ..\webapp            (Next.js, repo xiaowu-ai)
REM    - api  : services\legacy-api  (FastAPI, this repo)
REM
REM  Why legacy-api and NOT xiaowu_platform:
REM  /api/firmware/releases only exists in services\legacy-api.
REM  xiaowu_platform (the 8104 backend) has no firmware routes, so the
REM  flasher page would load with an empty version list behind it.
REM
REM  Usage:
REM    start_web_flash.bat          start both, open the browser
REM    start_web_flash.bat quiet    start both, no browser, no pause
REM                                 (used by start_all.bat)
REM
REM  Keep this file ASCII-only: cmd.exe parses .bat with the OEM codepage,
REM  any Chinese here turns into mojibake and breaks execution.
REM ============================================================
setlocal
set "ROOT=%~dp0"
set "WEBAPP=%ROOT%..\webapp"
set "VENV=%ROOT%.venv\Scripts\python.exe"
set "API_PORT=8092"
set "WEB_PORT=8091"
set "QUIET=%~1"

echo ============================================================
echo  Website / online flasher (local)
echo   page : http://localhost:%WEB_PORT%/zh/flash
echo   api  : http://127.0.0.1:%API_PORT%
echo ============================================================
echo.

if not exist "%WEBAPP%\package.json" (
    echo [error] webapp not found at:
    echo         %WEBAPP%
    echo         Expected layout: inksight-main\webapp next to xiaowu-s3-open-platform.
    goto :fail
)
if not exist "%WEBAPP%\node_modules" (
    echo [error] webapp\node_modules missing. Run once:
    echo         cd /d "%WEBAPP%" ^&^& npm install
    goto :fail
)
if not exist "%VENV%" (
    echo [error] .venv not found. Run run_backend.bat once to create it.
    goto :fail
)

REM ---- 1) point the page at the local API --------------------
REM .env.local is read at Next boot only, so it must be right BEFORE start.
set "ENVFILE=%WEBAPP%\.env.local"
set "CUR="
if exist "%ENVFILE%" (
    for /f "usebackq tokens=1,* delims==" %%A in ("%ENVFILE%") do (
        if /i "%%A"=="INKSIGHT_BACKEND_API_BASE" set "CUR=%%B"
    )
)
if /i "%CUR%"=="http://127.0.0.1:%API_PORT%" (
    echo [env  ] %ENVFILE%
    echo         INKSIGHT_BACKEND_API_BASE already OK.
) else (
    if exist "%ENVFILE%" copy /Y "%ENVFILE%" "%ENVFILE%.bak" >nul
    > "%ENVFILE%" (
        echo # generated by start_web_flash.bat
        echo INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:%API_PORT%
        echo NEXT_PUBLIC_API_BASE=http://127.0.0.1:%API_PORT%
    )
    echo [env  ] wrote %ENVFILE%  -^> http://127.0.0.1:%API_PORT%
    if exist "%ENVFILE%.bak" echo         previous file kept as .env.local.bak
)
echo.

REM ---- 2) free the ports ------------------------------------
REM A stale dev server keeps its own .env in memory and will happily proxy
REM to the wrong backend, which looks like "the page is broken". Kill first.
call :free_port %API_PORT%
call :free_port %WEB_PORT%
echo.

REM ---- 3) api 8092 ------------------------------------------
echo [api  ] starting services\legacy-api on %API_PORT% ...
start "Xiaowu API %API_PORT%" /min cmd /k "cd /d %ROOT%services\legacy-api && %VENV% -m uvicorn api.index:app --host 127.0.0.1 --port %API_PORT%"

REM ---- 4) web 8091 ------------------------------------------
echo [web  ] starting webapp (next dev) on %WEB_PORT% ...
start "Xiaowu Web %WEB_PORT%" /min /D "%WEBAPP%" cmd /k "npm run dev"

echo.
echo  Waiting for the dev server to compile ...
ping -n 12 127.0.0.1 >nul

if /i "%QUIET%"=="quiet" (
    echo  Started. Open http://localhost:%WEB_PORT%/zh/flash
    exit /b 0
)

start "" http://localhost:%WEB_PORT%/zh/flash
echo.
echo  Close the two minimized windows to stop.
echo.
pause
exit /b 0

:free_port
for /f "tokens=5" %%P in ('netstat -ano ^| findstr /R /C:":%~1 .*LISTENING"') do (
    echo        killing PID %%P on port %~1
    taskkill /F /PID %%P >nul 2>&1
)
exit /b 0

:fail
if /i not "%QUIET%"=="quiet" pause
exit /b 1
