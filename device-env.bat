@echo off
REM ============================================================
REM  device-env.bat  -  point the DEVICE at a backend
REM
REM    device-env.bat lan            show this PC's LAN URL + health
REM    device-env.bat local          device talks to THIS PC (port 8104)
REM    device-env.bat online         device talks to the cloud
REM    device-env.bat status         show current setting
REM
REM  Add "flash" as the 2nd word to also build and flash:
REM    device-env.bat local flash
REM
REM  A "local" build keeps the cloud URL as FALLBACK, so the device
REM  still works when this PC is off. One flash covers both modes.
REM
REM  How it works: writes an optional header
REM    main\boards\custom\ssd2683za-s3-epd42\local_server.h
REM  which config.h picks up via __has_include. Deleting that file
REM  restores the factory default (cloud). Nothing else is touched.
REM
REM  ASCII only: cmd.exe parses .bat with the OEM codepage.
REM ============================================================
setlocal EnableDelayedExpansion
cd /d "%~dp0"
set "ROOT=%~dp0"
set "HDR=%ROOT%firmware\s3\main\boards\custom\ssd2683za-s3-epd42\local_server.h"
set "MODE=%~1"
set "DOFLASH=%~2"
if "%MODE%"=="" set "MODE=status"

if /i "%MODE%"=="status" goto :status
if /i "%MODE%"=="lan"    goto :lan
if /i "%MODE%"=="local"  goto :local
if /i "%MODE%"=="online" goto :online
if /i "%MODE%"=="cloud"  goto :online

echo usage: device-env.bat [lan^|local^|online^|status] [flash]
exit /b 1

REM ------------------------------------------------------------
:status
echo ============================================================
echo  Device backend (firmware)
echo ============================================================
if exist "%HDR%" (
    echo  [LOCAL] override file present:
    findstr /C:"INKSIGHT_DEFAULT_SERVER_URL" "%HDR%"
) else (
    echo  [ONLINE] no override - firmware uses the cloud domain.
)
echo.
echo  Switches:  device-env.bat local flash   ^|   device-env.bat online flash
exit /b 0

REM ------------------------------------------------------------
:lan
call :detect_ip
if not defined LAN_IP (
    echo  [warn] cannot detect a LAN IP ^(no default gateway?^).
    echo         Connect Wi-Fi/Ethernet, then run: device-env.bat lan
    exit /b 1
)
set "LOCAL_URL=http://%LAN_IP%:8104"
echo  This PC (LAN)     : %LAN_IP%
call :check_health
echo  Device must use   : %LOCAL_URL%   [health: %CODE%]
if exist "%HDR%" (
    echo  Current firmware  : LOCAL ^(override file present^)
) else (
    echo  Current firmware  : ONLINE ^(run: device-env.bat local flash^)
)
exit /b 0

REM ------------------------------------------------------------
:local
echo ============================================================
echo  Switch device to LOCAL backend
echo ============================================================
call :detect_ip
if not defined LAN_IP (
    echo [error] cannot detect LAN IP.
    echo         Connect Wi-Fi/Ethernet first, then retry.
    pause
    exit /b 1
)
set "LOCAL_URL=http://%LAN_IP%:8104"
echo [1/3] LAN IP     : %LAN_IP%
echo [2/3] device URL : %LOCAL_URL%
call :check_health
if not "%CODE%"=="200" (
    echo       [warn] /health returned "%CODE%" - backend not reachable.
    echo              Run start_all.bat first, and allow Python through
    echo              Windows Firewall on PRIVATE networks.
)
echo [3/3] writing override ...
> "%HDR%" echo // GENERATED by device-env.bat - do NOT commit. Delete to restore cloud.
>>"%HDR%" echo #pragma once
>>"%HDR%" echo #define INKSIGHT_DEFAULT_SERVER_URL  "%LOCAL_URL%"
>>"%HDR%" echo #define INKSIGHT_SERVER_CANDIDATES   "%LOCAL_URL%,https://dual.xiaowuai.vip/backend"
echo       done: %HDR%
echo.
goto :maybe_flash

REM ------------------------------------------------------------
:online
if exist "%HDR%" (
    del "%HDR%" >nul 2>&1
    echo  Override removed - firmware falls back to the cloud domain.
) else (
    echo  Already ONLINE - nothing to do.
)
set "LOCAL_URL="
echo.
goto :maybe_flash

REM ------------------------------------------------------------
:maybe_flash
if /i "%DOFLASH%"=="flash" goto :flash
echo  The device only reads this at boot, so rebuild + flash it:
echo      device-env.bat %MODE% flash
echo  or in an ESP-IDF window:
echo      cd firmware\s3 ^&^& idf.py build ^&^& idf.py flash
exit /b 0

REM ------------------------------------------------------------
:flash
echo.
echo [build] preparing ESP-IDF environment ...
if not defined IDF_PATH (
    if exist "%USERPROFILE%\esp\v5.5.2\esp-idf\export.bat" (
        call "%USERPROFILE%\esp\v5.5.2\esp-idf\export.bat" >nul
    ) else (
        echo [error] ESP-IDF not found at %USERPROFILE%\esp\v5.5.2\esp-idf
        echo         Open an "ESP-IDF" prompt and run:
        echo             cd firmware\s3 ^&^& idf.py build ^&^& idf.py flash
        pause
        exit /b 1
    )
)
cd /d "%ROOT%firmware\s3"
echo [build] ninja -C build
ninja -C build
if errorlevel 1 (
    echo [error] build failed - see the lines above.
    pause
    exit /b 1
)
echo.
echo [flash] idf.py flash
idf.py flash
if errorlevel 1 (
    echo [error] flash failed - is the board connected / port free?
    pause
    exit /b 1
)
echo.
echo Done. In the boot log look for:
echo     XiaowuAI server ... resolved: ...
echo With the override in place it should resolve to the URL above;
echo when this PC is off it falls back to https://dual.xiaowuai.vip/backend.
pause
exit /b 0

REM ------------------------------------------------------------
:detect_ip
set "LAN_IP="
set "IPTMP=%TEMP%\xiaowu_lan_ip.txt"
powershell -NoProfile -Command "$c=Get-NetIPConfiguration | Where-Object {$_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq 'Up'} | Select-Object -First 1; if($c){$c.IPv4Address.IPAddress}" > "%IPTMP%" 2>nul
set /p LAN_IP=<"%IPTMP%"
del "%IPTMP%" >nul 2>&1
if defined LAN_IP exit /b 0
REM fallback: any non-loopback, non-link-local IPv4
powershell -NoProfile -Command "(Get-NetIPAddress -AddressFamily IPv4 | Where-Object {$_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254*'} | Select-Object -First 1).IPAddress" > "%IPTMP%" 2>nul
set /p LAN_IP=<"%IPTMP%"
del "%IPTMP%" >nul 2>&1
exit /b 0

REM ------------------------------------------------------------
:check_health
set "CODE=n/a"
where curl >nul 2>&1
if errorlevel 1 exit /b 0
curl -s -m 3 -o NUL -w "%%{http_code}" "%LOCAL_URL%/health" > "%TEMP%\xiaowu_hc.txt" 2>nul
set /p CODE=<"%TEMP%\xiaowu_hc.txt"
del "%TEMP%\xiaowu_hc.txt" >nul 2>&1
if not defined CODE set "CODE=n/a"
exit /b 0
